# Copy to .env and fill in real values. Never commit .env.

HOST=http://localhost
PORT=7000

# Mongo connection string (see db.js)
MONGO_URI=mongodb://127.0.0.1:27017/popcorn

# Any long random string, used to sign auth tokens
JWT_SECRET=change-me-to-a-long-random-string

# Gmail (or other SMTP-via-nodemailer) account used to send verification emails.
# For Gmail, use an App Password, not your real account password.
EMAIL_ID=your-sender-account@gmail.com
EMAIL_PASSWORD=your-app-password

# Razorpay test/live keys - https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxx
RAZORPAY_SECRET=your-razorpay-secret
